# Paste your Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Password for the vet dashboard at http://localhost:3000/vet
VET_PASSWORD=change-me

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# RAFEEQ_EFFORT=low     # low = fastest replies; medium/high = deeper answers, slower
# PORT=3000
# HOST=0.0.0.0        # lets the vet open /vet from a tablet on the same Wi-Fi

# On Vercel only (added automatically when you connect Upstash Redis in Vercel > Storage):
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
